# Optional backend port. The backend always binds to this device only.
PORT=3001

# Optional local data location; Windows defaults to %LOCALAPPDATA%\WhatDidIMiss.
# Keep this on a local, non-synced drive.
# WHAT_DID_I_MISS_DATA_DIR=

# Vercel UI only: allow the exact HTTPS origin of the deployed frontend.
# Replace the example with your Vercel production domain before starting the local API.
# WHAT_DID_I_MISS_ALLOWED_ORIGINS=https://your-project.vercel.app

# The Vercel project environment variable should point to this device's companion.
# VITE_LOCAL_API_URL=http://127.0.0.1:3001
